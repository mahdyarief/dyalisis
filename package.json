{
  "name": "dyalisis",
  "version": "0.3.0",
  "description": "Feature-analysis visualization engine (Cytoscape.js + shadcn/ui) — flow/flowchart/UML/node-flow for app documentation. Compiled to single self-contained HTML. Engine & content detachable. Framework: Dyalisis.",
  "type": "module",
  "bin": {
    "dyalisis": "bin/dyalisis.mjs"
  },
  "files": [
    "bin",
    "lib",
    "server",
    "build.mjs",
    "scripts",
    "src/components",
    "src/lib",
    "src/index.jsx",
    "src/styles.css",
    "src/data/example.js",
    "test",
    "template.html",
    "tailwind.config.js",
    "AGENTS.md",
    "README.md",
    "CONTRIBUTING.md",
    "DEPLOY.md",
    "Dockerfile",
    "docker-compose.yml",
    ".claude/skills"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node bin/dyalisis.mjs build",
    "test": "node bin/dyalisis.mjs test",
    "test:publish": "node test/publish.mjs",
    "test:mcp": "node test/mcp.mjs",
    "serve": "node bin/dyalisis.mjs serve",
    "serve:mcp": "node bin/dyalisis.mjs serve --mcp",
    "patch-elk": "node scripts/patch-elk.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.32.0",
    "cytoscape-dagre": "^4.0.1",
    "cytoscape-elk": "^1.1.0",
    "cytoscape-popper": "^2.0.0",
    "elkjs": "^0.9.3",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.17"
  }
}
